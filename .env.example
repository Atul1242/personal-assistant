# Copy this file to .env and fill in the values. Never commit .env.

# --- Claude (summaries) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model and effort used for summaries
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- Which sources to read (true/false) ---
ENABLE_GMAIL=true
ENABLE_CALENDAR=true
ENABLE_TELEGRAM=true
ENABLE_WHATSAPP=true

# --- Google (Gmail + Calendar) ---
# Path to the OAuth "Desktop app" client JSON downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials.json
# How many unread emails to include per digest
GMAIL_MAX_EMAILS=30
# How many hours ahead to look for calendar events
CALENDAR_LOOKAHEAD_HOURS=36

# --- Telegram (reading your chats as you) ---
# Get these at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Filled in by `npm run auth:telegram`
TELEGRAM_SESSION=

# --- Delivery: where your digest is sent ---
# Recommended: create a bot with @BotFather and paste its token here, then send it /start.
# If empty, digests go to your Telegram "Saved Messages" instead.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (the bot only talks to this id). Get it from @userinfobot.
TELEGRAM_OWNER_CHAT_ID=

# --- Schedule ---
# Cron expressions, comma separated (default: 8am, 1pm and 8pm)
DIGEST_SCHEDULE=0 8 * * *,0 13 * * *,0 20 * * *
TIMEZONE=Asia/Kolkata
